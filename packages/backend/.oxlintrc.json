{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "jsPlugins": ["./lint/transactions-boundary-plugin.mjs"],
  "rules": {
    "boundary/no-direct-transactions-queries": "error",
    "boundary/raw-sql-transactions": "error",
    "typescript/no-empty-object-type": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_shareContext", "_bankProviderType", "_previousDataValues"]
      }
    ],
    "no-unused-vars": [
      "warn",
      {
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-new-array": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-single-promise-in-promise-methods": "warn",
    "unicorn/no-invalid-fetch-options": "warn",
    "unicorn/prefer-optional-catch-binding": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/models/transactions-query/**",
        "src/models/transactions.model.ts",
        "src/services/transactions/planned-matching/**",
        "src/services/transactions/create-transaction.ts",
        "src/services/transactions/update-transaction/update-transaction.ts",
        "src/services/transactions/delete-transaction.ts",
        "src/services/transactions/bulk-delete.ts",
        "src/services/transactions/bulk-update.ts"
      ],
      "rules": {
        "boundary/no-direct-transactions-queries": "off"
      }
    },
    {
      "files": ["src/migrations/**"],
      "rules": {
        "boundary/no-direct-transactions-queries": "off",
        "boundary/raw-sql-transactions": "off"
      }
    },
    {
      "files": ["**/*.e2e.ts", "**/*.spec.ts", "**/*.unit.ts", "src/tests/**"],
      "rules": {
        "boundary/no-direct-transactions-queries": "off",
        "boundary/raw-sql-transactions": "off"
      }
    }
  ],
  "ignorePatterns": ["src/seeders/**/*.js", "src/migrations/**/*.js", "config/**", "dist"]
}
