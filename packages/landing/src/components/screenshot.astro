---
import { screenshotVariants } from '@/lib/themed-screenshots';

interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'eager' | 'lazy';
}

const { name, alt, width, height, loading = 'lazy' } = Astro.props;
const base = `/img/landing/screenshots/${name}`;
const variants = screenshotVariants({ base });
---

{
  variants.map(({ src, theme }) => (
    <picture class:list={['shot', theme]}>
      <img
        src={`${src}@1x.webp`}
        srcset={`${src}@1x.webp 1x, ${src}@2x.webp 2x`}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
      />
    </picture>
  ))
}
