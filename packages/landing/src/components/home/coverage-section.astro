---
import { getFeaturePage } from '@/lib/features';
import '@/styles/home/coverage.css';
import { useI18n } from '@/i18n';

const { t, url } = useI18n(Astro);

const importHref = getFeaturePage({ slug: 'import-transactions' }).href;

const PROVIDERS = [
  {
    name: 'Lunch Flow',
    href: 'https://lunchflow.app/coverage',
    logo: 'lunch-flow.webp',
    size: 96,
    countries: [
      { code: 'us', name: 'USA' },
      { code: 'eu', name: 'EU' },
      { code: 'gb', name: 'UK' },
      { code: 'ca', name: 'Canada' },
      { code: 'au', name: 'Australia' },
      { code: 'nz', name: 'New Zealand' },
    ],
    more: true,
    note: '20,000+ banks',
    paid: true,
    cta: 'Check coverage',
  },
  {
    name: 'SimpleFIN',
    href: 'https://beta-bridge.simplefin.org',
    logo: 'simplefin.webp',
    size: 128,
    countries: [
      { code: 'us', name: 'USA' },
      { code: 'ca', name: 'Canada' },
    ],
    paid: true,
    cta: 'Check coverage',
  },
  { name: 'Monobank', href: 'https://monobank.ua', logo: 'monobank.webp', size: 128, countries: [{ code: 'ua', name: 'Ukraine' }], cta: 'Visit site' },
  { name: 'Akahu', href: 'https://akahu.nz', logo: 'akahu.svg', size: 500, countries: [{ code: 'nz', name: 'New Zealand' }], cta: 'Visit site' },
  {
    name: 'Walutomat',
    href: 'https://walutomat.pl',
    logo: 'walutomat.webp',
    size: 128,
    countries: [{ code: 'pl', name: 'Poland' }],
    note: 'Currency exchange platform',
    cta: 'Visit site',
  },
  {
    name: 'Enable Banking',
    href: 'https://enablebanking.com/open-banking-apis',
    logo: 'enable-banking.webp',
    size: 128,
    countries: [
      { code: 'eu', name: 'EU' },
      { code: 'gb', name: 'UK' },
    ],
    note: 'Self-hosted, and existing cloud users only. Technical setup.',
    beta: true,
    cta: 'Check coverage',
  },
];

const FORMATS = ['YNAB', 'Wallet', 'Microsoft Money', 'CSV', 'OFX', t('Bank statements')];
---

<section class="sec" id="coverage">
  <div class="wrap">
    <div class="cov">
      <div>
        <p class="eyebrow">{t('Bank connections')}</p>
        <h2>{t('Connect through the provider that covers your bank')}</h2>
        <p class="lede">{t('Coverage depends on the provider, so check its own page for your bank before you start.')}</p>
        <div class="plate strip trust2">
          <span class="itile"><svg class="ic" aria-hidden="true"><use href="#r-lock"></use></svg></span>
          <div><strong>{t('Sync is read-only')}</strong><span>{t('It can never move your money.')}</span></div>
        </div>
      </div>
      <div>
        <div class="provs">
          {
            PROVIDERS.map((p) => (
              <a class="plate prov" href={p.href} target="_blank" rel="noopener noreferrer">
                <span class="prov-top">
                  <span class="source-mark logo">
                    <img src={`/img/landing/logos/${p.logo}`} alt="" width={p.size} height={p.size} loading="lazy" decoding="async" />
                  </span>
                  <strong>{p.name}</strong>
                </span>
                <div class="prov-loc">
                  <ul class="prov-where">
                    {p.countries.map((c) => (
                      <li class="ctry">
                        <img class="flag" src={`/img/landing/flags/${c.code}.svg`} alt="" width="18" height="13" loading="lazy" decoding="async" />
                        {t(c.name)}
                      </li>
                    ))}
                    {p.more && <li class="ctry-more">{t('and more')}</li>}
                  </ul>
                  {p.note && <small>{t(p.note)}</small>}
                </div>
                <span class="prov-foot">
                  <span class="prov-tags">
                    {p.paid ? <span class="tag paid">{t('Paid separately')}</span> : <span class="tag live">{t('Free')}</span>}
                    {p.beta && <span class="tag">{t('Beta')}</span>}
                  </span>
                  <em>
                    {t(p.cta)}
                    <svg class="ic" aria-hidden="true"><use href="#f-out"></use></svg>
                  </em>
                </span>
              </a>
            ))
          }
        </div>
        <div class="plate strip imp">
          <div>
            <strong>{t('Bank not listed?')}</strong><span><a class="imp-link" href={url({ href: importHref })}>{t('Import your history instead.')}</a></span>
          </div>
          <ul class="fmt">{FORMATS.map((f) => <li>{f}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>
