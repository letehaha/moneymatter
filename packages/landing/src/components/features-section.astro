---
import Screenshot from '@/components/screenshot.astro';

const SHOWCASES = [
  {
    title: 'Full Net Worth',
    text: 'Everything you own and owe in one picture.',
    bullets: [
      'Cash, investments, vehicles, venture deals, and loans on one chart',
      'Filter by asset type and pick any period',
      'See what changed, and by how much',
    ],
    iconClass: 'from-emerald-500/10 to-emerald-600/10 text-emerald-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
    image: { name: 'net-worth', width: 1503, height: 975, mobile: { width: 1084, height: 1899 } },
    alt: 'Net worth history chart stacked by cash, investments, vehicles, and ventures',
  },
  {
    title: 'Investments',
    text: 'Track portfolios next to your everyday accounts.',
    bullets: [
      'Stocks, ETFs, and crypto with automatic prices',
      'Cost basis, realized and unrealized return per holding',
      'Separate portfolios for each strategy',
    ],
    iconClass: 'from-violet-500/10 to-violet-600/10 text-violet-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M9 5v4"/><rect width="4" height="6" x="7" y="9" rx="1"/><path d="M9 15v2"/><path d="M17 3v2"/><rect width="4" height="8" x="15" y="5" rx="1"/><path d="M17 13v3"/><path d="M3 3v16a2 2 0 0 0 2 2h16"/></svg>`,
    image: { name: 'investments', width: 1515, height: 1340 },
    alt: 'Investment portfolio with total value, total return, and gains per holding',
  },
  {
    title: 'FIRE Planner',
    text: 'When you could stop working, based on what you actually spend and save.',
    bullets: [
      'Spending and savings rate taken from your own history',
      'Lean, Regular, Fat, Barista, and Coast targets side by side',
      'Milestones, a projection chart, and a dashboard widget',
    ],
    iconClass: 'from-orange-500/10 to-orange-600/10 text-orange-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
    image: { name: 'fire', width: 1504, height: 980 },
    alt: 'FIRE planner with time to FIRE, progress toward the target, Lean to Coast targets, and the projection chart',
  },
  {
    title: 'Reports & Insights',
    text: 'Answers to "where did the money go?" without a spreadsheet.',
    bullets: [
      'Cash flow: income against expenses, month by month',
      'Money flow: from each income source to each category',
      'Pivot tables: slice by category, payee, account, or period',
    ],
    iconClass: 'from-sky-500/10 to-sky-600/10 text-sky-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M21 12c.552 0 1.005-.449.95-.998a10 10 0 0 0-8.953-8.951c-.55-.055-.998.398-.998.95v8a1 1 0 0 0 1 1z"/><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/></svg>`,
    image: { name: 'money-flow', width: 1504, height: 1414 },
    alt: 'Money flow diagram from income through expenses and savings to categories',
  },
  {
    title: 'Switch in One Click',
    text: 'Bring your history with you, whatever you used before.',
    bullets: [
      'Direct importers for YNAB, Wallet by BudgetBakers, and Microsoft Money',
      'CSV with column mapping and duplicate handling, plus OFX and QFX',
      'Paste a bank statement or an email, and AI turns it into transactions',
    ],
    iconClass: 'from-cyan-500/10 to-cyan-600/10 text-cyan-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 12v6"/><path d="m15 15-3-3-3 3"/></svg>`,
    image: { name: 'import-sources', width: 1344, height: 1082 },
    alt: 'Import options: any text source, CSV, OFX, YNAB, Wallet, and Microsoft Money',
  },
];
---

<section id="features" class="relative z-10 py-16 sm:py-24">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Core Features</h2>
      <p class="text-muted-foreground mt-4 text-lg">Banks, budgets, investments, and reports in one place.</p>
    </div>

    <!-- Feature showcases -->
    <div class="mt-16 space-y-16 sm:space-y-24">
      {
        SHOWCASES.map((item, index) => (
          <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
            <div class="text-center lg:text-left">
              <div
                class:list={[
                  'mx-auto mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br lg:mx-0',
                  item.iconClass,
                ]}
                set:html={item.icon}
              />
              <h3 class="text-2xl font-bold tracking-tight">{item.title}</h3>
              <p class="text-muted-foreground mt-3 text-lg">{item.text}</p>
              <ul class="mx-auto mt-6 w-fit space-y-3 text-left lg:mx-0">
                {item.bullets.map((bullet) => (
                  <li class="text-muted-foreground flex gap-3 text-sm">
                    <span class="text-primary">✓</span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
            <div class:list={[index % 2 === 0 && 'lg:order-first']}>
              <div class="border-border/50 bg-background overflow-hidden rounded-2xl border p-3 sm:p-4">
                <Screenshot {...item.image} alt={item.alt} />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Features grid -->
    <div class="mt-16 sm:mt-24 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Bank Connections -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-blue-500/10 to-blue-600/10 text-blue-500"
        >
          <!-- Building2 -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">Bank Connections</h3>
        <p class="text-muted-foreground text-sm">
          Auto-sync through LunchFlow, SimpleFIN, and Monobank, covering thousands of banks across the US, Canada,
          and Europe. More providers coming.
        </p>
      </div>

      <!-- AI That Works for You -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-purple-500/10 to-pink-500/10 text-purple-500"
        >
          <!-- Bot -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">AI That Works for You</h3>
        <p class="text-muted-foreground text-sm">
          Auto-categorization that learns your patterns. Use our AI or bring your own endpoint. Any OpenAI-compatible
          API works, including a local model.
        </p>
      </div>

      <!-- Budgets -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-orange-500/10 to-orange-600/10 text-orange-500"
        >
          <!-- BarChart3 -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">Budgets</h3>
        <p class="text-muted-foreground text-sm">
          Set budgets and track progress. Refunds count back automatically, and you can share a budget with
          collaborators.
        </p>
      </div>

      <!-- Recurring & Scheduled -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-amber-500/10 to-amber-600/10 text-amber-500"
        >
          <!-- CalendarClock -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">
          Recurring & Scheduled
          <span
            class="ml-1 rounded bg-purple-500/20 px-1.5 py-0.5 align-middle text-xs font-medium text-purple-400"
          >
            New
          </span>
        </h3>
        <p class="text-muted-foreground text-sm">
          Plan recurring charges and income. See upcoming payments before they hit your balance.
        </p>
      </div>

      <!-- Family Sharing -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-rose-500/10 to-pink-500/10 text-rose-500"
        >
          <!-- Users -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">Family Sharing</h3>
        <p class="text-muted-foreground text-sm">
          Share one account with a parent or accountant, or give a partner full visibility. Pick read-only or write
          access, scoped per recipient.
        </p>
      </div>

      <!-- Multi-Currency -->
      <div
        class="group border-border/50 bg-card hover:border-primary/50 relative overflow-hidden rounded-2xl border p-6 transition-all hover:shadow-lg"
      >
        <div
          class="mb-4 flex size-12 items-center justify-center rounded-xl bg-linear-to-br from-indigo-500/10 to-indigo-600/10 text-indigo-500"
        >
          <!-- Globe -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold">Multi-Currency</h3>
        <p class="text-muted-foreground text-sm">
          Any currency, automatic exchange rates. Useful when your salary and your rent are in different currencies.
        </p>
      </div>
    </div>

    <!-- Also in the box -->
    <div class="mt-12 text-center">
      <p class="text-muted-foreground text-xs font-medium tracking-wider uppercase">Also in the box</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Payees with logos & aliases
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Tags & notes
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Custom categories
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Split transactions
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Transfers & refunds
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Automation rules
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Data export
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Backup & restore
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Dark mode
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Mobile-friendly
        </span>
        <span class="border-border/50 bg-card text-muted-foreground rounded-full border px-3 py-1.5 text-xs">
          <span class="text-primary">+</span> Multiple languages
        </span>
      </div>
    </div>
  </div>
</section>
