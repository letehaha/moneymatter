---
import { ALTERNATIVE_PAGES } from '@/lib/alternatives';
import { FEATURE_PAGES } from '@/lib/features';
import { GITHUB_URL, REDDIT_URL, ROADMAP_URL } from '@/lib/github-api';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Features',
    links: [
      ...FEATURE_PAGES.filter((page) =>
        ['Bank Sync', 'Import Transactions', 'Budgeting', 'Multi-Currency', 'Investment Tracking', 'Net Worth Tracker', 'Self-Hosting'].includes(
          page.label,
        ),
      ),
      { label: 'All features', href: '/features' },
    ],
  },
  {
    title: 'Product',
    links: [
      { label: 'Pricing', href: '/#pricing' },
      { label: 'FAQ', href: '/#faq' },
      { label: 'Sign In', href: '/sign-in' },
      { label: 'Sign Up', href: '/sign-up' },
    ],
  },
  {
    title: 'Compare',
    links: [...ALTERNATIVE_PAGES, { label: 'All comparisons', href: '/alternatives' }],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Guides', href: '/guides' },
      { label: 'Docs', href: 'https://docs.moneymatter.app' },
      { label: 'GitHub', href: GITHUB_URL, track: 'landing_github_clicked' },
      { label: 'Reddit', href: REDDIT_URL, track: 'landing_reddit_clicked' },
      { label: 'Self-Host Guide', href: `${GITHUB_URL}/tree/main/self-hosting` },
      { label: 'Roadmap', href: ROADMAP_URL },
      { label: 'Changelog', href: `${GITHUB_URL}/releases` },
      { label: 'Support', href: '/support' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Terms of Use', href: '/terms-of-use' },
    ],
  },
];
---

<footer class="site-foot">
  <div class="wrap">
    <div class="foot">
      <div class="foot-brand2">
        <a class="brand" href="/"><svg aria-hidden="true"><use href="#mm-logo"></use></svg>MoneyMatter</a>
        <p>All your money, organized automatically.</p>
        <span class="tag">Open source · AGPL-3.0</span>
      </div>
      {
        columns.map((column) => (
          <div class="foot-col">
            <strong>{column.title}</strong>
            {column.links.map((link) => (
              <a
                href={link.href}
                {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                {...('track' in link ? { 'data-track': link.track, 'data-track-location': 'footer' } : {})}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
    <div class="foot-base"><span>&copy; {currentYear} MoneyMatter</span><span>Built in the open by one developer.</span></div>
  </div>
</footer>
