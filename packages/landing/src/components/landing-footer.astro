---
import { GITHUB_URL } from '@/lib/github-api';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Features', href: '/#features' },
      { label: 'Pricing', href: '/#pricing' },
      { label: 'FAQ', href: '/#faq' },
      { label: 'Sign In', href: '/sign-in' },
      { label: 'Sign Up', href: '/sign-up' },
    ],
  },
  {
    title: 'Compare',
    links: [{ label: 'Wallet by BudgetBakers alternative', href: '/alternatives/wallet-by-budgetbakers' }],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Docs', href: 'https://docs.moneymatter.app' },
      { label: 'GitHub', href: GITHUB_URL, track: 'landing_github_clicked' },
      { label: 'Self-Host Guide', href: `${GITHUB_URL}/tree/main/self-hosting` },
      { label: 'Roadmap', href: 'https://moneymatter.featurebase.app/dashboard/roadmap' },
      { label: 'Changelog', href: `${GITHUB_URL}/releases` },
      { label: 'Support', href: 'mailto:support@moneymatter.app' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Terms of Use', href: '/terms-of-use' },
    ],
  },
];
---

<footer class="border-border/40 relative overflow-hidden border-t py-12">
  <!-- Background gradient -->
  <div class="pointer-events-none absolute inset-0">
    <div class="footer-orb absolute -bottom-1/2 left-1/2 size-150 -translate-x-1/2 rounded-full"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <!-- Logo -->
        <div class="flex items-center gap-2">
          <div
            class="from-primary flex size-8 items-center justify-center rounded-lg bg-linear-to-br to-purple-600"
          >
            <!-- CircleDollarSign icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-white"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
          </div>
          <span class="font-semibold">MoneyMatter</span>
        </div>
        <p class="text-muted-foreground mt-4 text-sm">Your finances. Your server. Your rules.</p>
      </div>

      <!-- Links -->
      <div class="grid grid-cols-2 gap-x-12 gap-y-8 sm:grid-cols-4 md:gap-x-16">
        {
          columns.map((column) => (
            <div>
              <p class="text-sm font-semibold">{column.title}</p>
              <ul class="text-muted-foreground mt-4 space-y-3 text-sm">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="hover:text-foreground transition-colors"
                      {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      {...('track' in link ? { 'data-track': link.track, 'data-track-location': 'footer' } : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Copyright -->
    <p class="text-muted-foreground border-border/40 mt-10 border-t pt-8 text-sm">
      &copy; {currentYear} MoneyMatter. Open source under AGPL-3.0.
    </p>
  </div>
</footer>

<style>
  /*
    The orb must stay a plain radial gradient: a CSS blur re-rasterizes on every
    animation frame and pegs the iOS GPU.
  */
  .footer-orb {
    background: radial-gradient(
      circle closest-side,
      rgba(236, 72, 153, 0.09) 0%,
      rgba(236, 72, 153, 0.07) 20%,
      rgba(168, 85, 247, 0.05) 40%,
      rgba(168, 85, 247, 0.02) 70%,
      transparent 100%
    );
    animation:
      footer-float 12s infinite,
      footer-pulse 4s ease-in-out infinite;
  }

  @keyframes footer-float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(3%, 4%);
    }
    66% {
      transform: translate(-2%, -2%);
    }
  }

  @keyframes footer-pulse {
    0%,
    100% {
      opacity: 0.5;
      scale: 1;
    }
    50% {
      opacity: 0.8;
      scale: 1.15;
    }
  }

  /*
    Without the pulse animation the orb falls back to opacity 1, brighter than
    it ever appears animated, so pin a value inside the pulse's 0.5-0.8 range.
  */
  @media (pointer: coarse) {
    .footer-orb {
      animation: none;
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-orb {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
