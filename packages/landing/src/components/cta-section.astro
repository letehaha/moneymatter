---
import { GITHUB_URL } from '@/lib/github-api';
import { buildIso } from '@/lib/iso-scene.js';
import DemoStartButton from '@/components/demo-start-button.astro';

interface Props {
  /** Isometric scene behind the panel, with the home page copy. */
  illustration?: boolean;
}

const { illustration = false } = Astro.props;

const copy = illustration
  ? {
      title: 'All your money, organized automatically.',
      subtitle: 'Connect a bank, import a file, or start by hand.',
      ticks: ['Open source', 'Free to self-host', 'Read-only bank sync'],
    }
  : {
      title: 'Own your financial data',
      subtitle: 'Sign up for the cloud in a minute, or pull the Docker image and run it yourself.',
      ticks: ['No ads, data never sold', '14-day money-back', 'Cancel anytime', 'Export data anytime'],
    };
---

<section class="final">
  <div class="wrap">
    <div class="final-panel">
      {illustration && <div class="final-scene" aria-hidden="true" set:html={buildIso().finale} />}
      <svg class="final-logo" aria-hidden="true"><use href="#mm-logo"></use></svg>
      <h2>{copy.title}</h2>
      <p class="final-sub">{copy.subtitle}</p>
      <div class="hero-cta">
        <a
          class="btn btn-primary btn-lg"
          href="/sign-up"
          data-track="landing_cta_clicked"
          data-track-location="cta_section"
          >Try for free<svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"
            ></path></svg
          ></a
        >
        <DemoStartButton location="cta_section" />
      </div>
      <p class="hero-note">
        <strong>40-day free trial.</strong> No card needed.{' '}
        {
          !illustration && (
            <a
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-track="landing_github_clicked"
              data-track-location="cta_section"
            >
              View on GitHub
            </a>
          )
        }
      </p>
      <ul class="final-ticks">
        {
          copy.ticks.map((tick) => (
            <li>
              <svg class="ic" aria-hidden="true">
                <use href="#i-check" />
              </svg>
              {illustration && tick === 'Open source' ? (
                <a
                  href={GITHUB_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="landing_github_clicked"
                  data-track-location="cta_section"
                >
                  {tick}
                </a>
              ) : (
                tick
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

