---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

{
  items.map((item) => (
    <details class="group border-border/50 bg-card rounded-xl border px-5 py-4">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
        {item.question}
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground size-4 shrink-0 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <p class="text-muted-foreground mt-3 text-sm leading-relaxed">{item.answer}</p>
    </details>
  ))
}
