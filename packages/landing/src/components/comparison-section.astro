---
import CheckIcon from './icons/check-icon.astro';
import XIcon from './icons/x-icon.astro';
import DollarSignIcon from './icons/dollar-sign-icon.astro';
import CodeIcon from './icons/code-icon.astro';
import LandmarkIcon from './icons/landmark-icon.astro';
import TrendingUpIcon from './icons/trending-up-icon.astro';
import GlobeIcon from './icons/globe-icon.astro';
import BarChartIcon from './icons/bar-chart-icon.astro';
import DownloadIcon from './icons/download-icon.astro';
import BotIcon from './icons/bot-icon.astro';
import UsersIcon from './icons/users-icon.astro';
import LogOutIcon from './icons/log-out-icon.astro';
---

<section class="relative z-10 py-16 sm:py-24">
  <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Why MoneyMatter?</h2>
      <p class="text-muted-foreground mt-4 text-lg">Price, bank coverage, and who holds your data.</p>
    </div>

    <!-- Comparison Table (Desktop) -->
    <div class="border-border/50 bg-card mt-12 hidden overflow-x-auto rounded-2xl border md:block">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-border/50 border-b">
            <th class="text-muted-foreground px-6 py-4 text-left font-medium">Feature</th>
            <th class="text-muted-foreground px-6 py-4 text-center font-medium">Monarch, Copilot & co</th>
            <th class="text-muted-foreground px-6 py-4 text-center font-medium">YNAB</th>
            <th class="bg-primary/5 text-primary px-6 py-4 text-center font-semibold">MoneyMatter</th>
          </tr>
        </thead>
        <tbody class="divide-border/50 divide-y">
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <DollarSignIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Price</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">
              <span>$70–200/yr</span>
              <span class="text-muted-foreground block text-xs">Empower free, sells advice</span>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">$109/year</td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="font-medium">From $30/year</span>
              <span class="text-muted-foreground block text-xs">40-day free trial · self-host free forever</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <CodeIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Open Source<br />& Self-Hostable</span>
              </div>
            </td>
            <td class="px-6 py-3 text-center"><XIcon class="text-destructive-text mx-auto" /></td>
            <td class="px-6 py-3 text-center"><XIcon class="text-destructive-text mx-auto" /></td>
            <td class="bg-primary/5 px-6 py-3 text-center"><CheckIcon class="text-primary mx-auto" /></td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <LandmarkIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Bank Sync</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">US/CA aggregators only</td>
            <td class="text-muted-foreground px-6 py-3 text-center">US/CA + limited EU</td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="font-medium">30+ countries</span>
              <span class="text-muted-foreground block text-xs">LunchFlow · SimpleFIN · Monobank · Akahu</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <DownloadIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Import Your History</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">CSV / Mint only</td>
            <td class="text-muted-foreground px-6 py-3 text-center">CSV, OFX, QIF</td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="font-medium">One-click importers</span>
              <span class="text-muted-foreground block text-xs">YNAB · Wallet (BudgetBakers) · MS Money · CSV</span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <TrendingUpIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Investments</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">Balances only</td>
            <td class="text-muted-foreground px-6 py-3 text-center">Manual tracking</td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="inline-flex items-center gap-1.5">
                <CheckIcon class="text-primary" />
                <span class="text-muted-foreground text-xs">incl. crypto</span>
              </span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <GlobeIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Multi-Currency</span>
              </div>
            </td>
            <td class="px-6 py-3 text-center">
              <span class="inline-flex flex-col items-center gap-0.5">
                <XIcon class="text-destructive-text" />
                <span class="text-muted-foreground text-xs">USD/CAD only</span>
              </span>
            </td>
            <td class="px-6 py-3 text-center">
              <span class="inline-flex flex-col items-center gap-0.5">
                <XIcon class="text-destructive-text" />
                <span class="text-muted-foreground text-xs">one currency/budget</span>
              </span>
            </td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="inline-flex items-center gap-1.5">
                <CheckIcon class="text-primary" />
                <span class="text-muted-foreground text-xs">auto exchange rates</span>
              </span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <BarChartIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Reports & Analytics</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">Fixed dashboards</td>
            <td class="text-muted-foreground px-6 py-3 text-center">Basic</td>
            <td class="bg-primary/5 px-6 py-3 text-center font-medium">Pivot, cash flow, net worth</td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <BotIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Your Own AI (MCP)</span>
              </div>
            </td>
            <td class="px-6 py-3 text-center">
              <span class="inline-flex flex-col items-center gap-0.5">
                <XIcon class="text-destructive-text" />
                <span class="text-muted-foreground text-xs">beta / waitlist</span>
              </span>
            </td>
            <td class="px-6 py-3 text-center">
              <span class="inline-flex flex-col items-center gap-0.5">
                <XIcon class="text-destructive-text" />
                <span class="text-muted-foreground text-xs">unofficial only</span>
              </span>
            </td>
            <td class="bg-primary/5 px-6 py-3 text-center">
              <span class="inline-flex items-center gap-1.5">
                <CheckIcon class="text-primary" />
                <span class="text-muted-foreground text-xs">+ BYO model</span>
              </span>
            </td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <UsersIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Family Sharing</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">Whole-household or none</td>
            <td class="text-muted-foreground px-6 py-3 text-center">All-or-nothing</td>
            <td class="bg-primary/5 px-6 py-3 text-center font-medium">Per-account control</td>
          </tr>
          <tr>
            <td class="px-6 py-3">
              <div class="flex items-center gap-2">
                <LogOutIcon class="text-muted-foreground shrink-0" />
                <span class="font-medium">Leave Anytime</span>
              </div>
            </td>
            <td class="text-muted-foreground px-6 py-3 text-center">Capped CSV export</td>
            <td class="text-muted-foreground px-6 py-3 text-center">CSV export</td>
            <td class="bg-primary/5 px-6 py-3 text-center font-medium">Full export + backup</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Comparison List (Mobile) -->
    <div class="mt-12 space-y-4 md:hidden">
      <!-- Price -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <DollarSignIcon class="opacity-70" />
          <span class="font-semibold">Price</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">$70–200/yr</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">$109/year</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="text-right">
              <span class="block font-semibold">From $30/year</span>
              <span class="text-muted-foreground block text-xs">40-day free trial · self-host free forever</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Open Source & Self-Hostable -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <CodeIcon class="opacity-70" />
          <span class="font-semibold">Open Source & Self-Hostable</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <XIcon class="text-destructive-text" />
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <XIcon class="text-destructive-text" />
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <CheckIcon class="text-primary" />
          </div>
        </div>
      </div>

      <!-- Bank Sync -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <LandmarkIcon class="opacity-70" />
          <span class="font-semibold">Bank Sync</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">US/CA aggregators only</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">US/CA + limited EU</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="text-right">
              <span class="block font-semibold">30+ countries</span>
              <span class="text-muted-foreground block text-xs">LunchFlow · SimpleFIN · Monobank · Akahu</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Import Your History -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <DownloadIcon class="opacity-70" />
          <span class="font-semibold">Import Your History</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">CSV / Mint only</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">CSV, OFX, QIF</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="text-right">
              <span class="block font-semibold">One-click importers</span>
              <span class="text-muted-foreground block text-xs">YNAB · Wallet (BudgetBakers) · MS Money · CSV</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Investments -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <TrendingUpIcon class="opacity-70" />
          <span class="font-semibold">Investments</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">Balances only</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">Manual tracking</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="inline-flex items-center gap-1.5">
              <CheckIcon class="text-primary" />
              <span class="text-muted-foreground text-xs">incl. crypto</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Multi-Currency -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <GlobeIcon class="opacity-70" />
          <span class="font-semibold">Multi-Currency</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="flex flex-col items-end gap-0.5">
              <XIcon class="text-destructive-text" />
              <span class="text-muted-foreground text-xs">USD/CAD only</span>
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="flex flex-col items-end gap-0.5">
              <XIcon class="text-destructive-text" />
              <span class="text-muted-foreground text-xs">one currency/budget</span>
            </span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="inline-flex items-center gap-1.5">
              <CheckIcon class="text-primary" />
              <span class="text-muted-foreground text-xs">auto exchange rates</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Reports & Analytics -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <BarChartIcon class="opacity-70" />
          <span class="font-semibold">Reports & Analytics</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">Fixed dashboards</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">Basic</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="text-right font-semibold">Pivot, cash flow, net worth</span>
          </div>
        </div>
      </div>

      <!-- Your Own AI (MCP) -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <BotIcon class="opacity-70" />
          <span class="font-semibold">Your Own AI (MCP)</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="flex flex-col items-end gap-0.5">
              <XIcon class="text-destructive-text" />
              <span class="text-muted-foreground text-xs">beta / waitlist</span>
            </span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="flex flex-col items-end gap-0.5">
              <XIcon class="text-destructive-text" />
              <span class="text-muted-foreground text-xs">unofficial only</span>
            </span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="inline-flex items-center gap-1.5">
              <CheckIcon class="text-primary" />
              <span class="text-muted-foreground text-xs">+ BYO model</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Family Sharing -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <UsersIcon class="opacity-70" />
          <span class="font-semibold">Family Sharing</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">Household or none</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">All-or-nothing</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="font-semibold">Per-account control</span>
          </div>
        </div>
      </div>

      <!-- Leave Anytime -->
      <div class="border-border/50 bg-card rounded-xl border p-4">
        <div class="mb-3 flex items-center gap-2">
          <LogOutIcon class="opacity-70" />
          <span class="font-semibold">Leave Anytime</span>
        </div>
        <div class="space-y-2 text-sm">
          <div class="flex items-center justify-between">
            <span>Monarch & co</span>
            <span class="opacity-70">Capped CSV export</span>
          </div>
          <div class="flex items-center justify-between">
            <span>YNAB</span>
            <span class="opacity-70">CSV export</span>
          </div>
          <div class="bg-primary/10 -mx-4 flex items-center justify-between rounded-lg px-4 py-2">
            <span class="text-primary font-medium">MoneyMatter</span>
            <span class="font-semibold">Full export + backup</span>
          </div>
        </div>
      </div>
    </div>

    <p class="text-muted-foreground mt-6 text-center text-xs">
      Compared August 2026 against Monarch, Copilot, Simplifi, Empower, and PocketGuard.
    </p>
  </div>
</section>
