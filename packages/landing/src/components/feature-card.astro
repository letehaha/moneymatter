---
import LucideIcon from '@/components/lucide-icon.astro';

interface Props {
  page: { label: string; href: string; icon: string; summary: string };
}

const { page } = Astro.props;
---

<a href={page.href} class="border-border/50 bg-card hover:border-primary/50 block h-full rounded-2xl border p-5 transition-all">
  <span class="flex items-center gap-3 font-semibold">
    <LucideIcon name={page.icon} class="text-primary-text size-5 shrink-0" />
    {page.label}
  </span>
  <span class="text-muted-foreground mt-2 block text-sm leading-relaxed">{page.summary}</span>
</a>
