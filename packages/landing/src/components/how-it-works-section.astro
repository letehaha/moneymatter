---
import Screenshot from '@/components/screenshot.astro';

const STEPS = [
  {
    title: 'Bring your money in',
    text: 'Connect your bank, or import your history from YNAB, Wallet, or a CSV file.',
    image: { name: 'bank-providers', width: 1336, height: 846 },
    alt: 'Bank provider picker listing LunchFlow, SimpleFIN, and Monobank',
  },
  {
    title: 'It sorts itself',
    text: 'Each transaction gets a category and a payee. AI learns your patterns, and your rules handle the rest.',
    image: { name: 'transactions', width: 1441, height: 1045 },
    alt: 'Transactions list with categories, accounts, and payee logos',
  },
  {
    title: 'See where you stand',
    text: 'Income against expenses, savings rate, and net worth, month by month.',
    image: { name: 'cash-flow', width: 1503, height: 1016 },
    alt: 'Cash flow report with monthly income and expense bars',
  },
];
---

<section id="how-it-works" class="relative z-10 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">How it works</h2>
      <p class="text-muted-foreground mt-4 text-lg">From bank statement to the full picture in three steps.</p>
    </div>

    <ol class="mt-16 grid gap-8 lg:grid-cols-3">
      {
        STEPS.map((step, index) => (
          <li class="border-border/50 bg-card overflow-hidden rounded-2xl border">
            <div class="bg-background relative aspect-3/2 overflow-hidden">
              <Screenshot {...step.image} alt={step.alt} class="h-full object-cover object-left-top" />
              <div class="from-card pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-linear-to-t to-transparent" />
            </div>
            <div class="p-6">
              <p class="text-primary text-sm font-semibold">Step {index + 1}</p>
              <h3 class="mt-1 mb-2 text-lg font-semibold">{step.title}</h3>
              <p class="text-muted-foreground text-sm">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
