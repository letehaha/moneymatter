---
/**
 * Hero section — mostly static, with Vue island slots for
 * TryDemoButton, DemoPortal and GitHubActivity.
 */
---

<section data-hero-section class="relative z-10 overflow-hidden py-20 sm:pt-40 sm:pb-32">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <!-- Badge -->
      <div
        class="hero-fade-in border-border/60 bg-card/50 mb-8 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-sm backdrop-blur-sm"
        style="animation-delay: 0.1s"
      >
        <span class="size-2 shrink-0 animate-pulse rounded-full bg-green-500"></span>
        <span class="text-muted-foreground">
          <span>Open source &bull; AGPL-3.0</span>
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="hero-fade-in hero-title mx-auto max-w-5xl text-3xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
      >
        Your finances. Your server.
        <span class="hero-gradient-text inline-block bg-clip-text leading-tight text-transparent">
          Your rules.
        </span>
      </h1>

      <!-- Subheadline -->
      <p
        class="hero-fade-in text-muted-foreground mx-auto mt-6 max-w-2xl text-lg sm:text-xl"
        style="animation-delay: 0.35s"
      >
        Open-source personal finance tracking. Self-host it for free with Docker, or use our cloud from $2.50/mo, billed
        yearly. Your data is never sold or shared.
      </p>

      <!-- CTA Buttons -->
      <div
        class="hero-fade-in mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
        style="animation-delay: 0.45s"
      >
        <div class="flex flex-col items-center gap-2">
          <a
            href="/sign-up"
            class="group bg-primary text-primary-foreground shadow-primary/25 hover:bg-primary/90 hover:shadow-primary/30 flex w-full items-center justify-center gap-2 rounded-xl px-8 py-3.5 text-base font-semibold shadow-lg transition-all hover:shadow-xl sm:w-auto"
            data-track="landing_cta_clicked"
            data-track-location="hero"
          >
            Get Started
            <!-- ArrowRight -->
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 transition-transform group-hover:translate-x-0.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <span class="text-muted-foreground text-xs">40-day free trial, no card needed</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <!-- Vue island: TryDemoButton will be placed here -->
          <slot name="try-demo" />
        </div>
      </div>

      <a
        href="https://testflight.apple.com/join/tm5q4V5H"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-fade-in mt-8 inline-flex items-center gap-3 rounded-xl border border-white/25 bg-black px-5 py-2.5 text-left text-white transition-colors hover:border-white/60"
        style="animation-delay: 0.5s"
        data-track="landing_testflight_clicked"
        data-track-location="hero"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" class="size-7 shrink-0" aria-hidden="true"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04c-2.04.027-3.91 1.183-4.961 3.014c-2.117 3.675-.546 9.103 1.519 12.09c1.013 1.454 2.208 3.09 3.792 3.039c1.52-.065 2.09-.987 3.935-.987c1.831 0 2.35.987 3.96.948c1.637-.026 2.676-1.48 3.676-2.948c1.156-1.688 1.636-3.325 1.662-3.415c-.039-.013-3.182-1.221-3.22-4.857c-.026-3.04 2.48-4.494 2.597-4.559c-1.429-2.09-3.623-2.324-4.39-2.376c-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83c-1.207.052-2.662.805-3.532 1.818c-.78.896-1.454 2.338-1.273 3.714c1.338.104 2.715-.688 3.559-1.701"/></svg>
        <span class="flex flex-col leading-tight">
          <span class="text-xs">Get the iPhone app beta on</span>
          <span class="text-xl font-semibold">TestFlight</span>
        </span>
      </a>

      <p class="hero-fade-in text-muted-foreground mt-6 text-sm" style="animation-delay: 0.55s">
        <a
          href="https://moneymatter.featurebase.app/dashboard/roadmap"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground underline underline-offset-4 transition-colors"
          data-track="landing_roadmap_clicked"
          data-track-location="hero"
        >
          Shape the roadmap with your feedback
        </a>
      </p>

      <!-- App Preview -->
      <div class="hero-fade-in relative mx-auto mt-16 max-w-5xl" style="animation-delay: 0.7s">
        <div
          data-hero-frame
          class="border-border/50 from-card to-card/50 relative overflow-hidden rounded-2xl border bg-linear-to-b shadow-2xl"
        >
          <!-- Browser chrome -->
          <div class="border-border/50 bg-card flex items-center gap-2 border-b px-4 py-3">
            <div class="flex gap-1.5">
              <div class="size-3 rounded-full bg-red-500/80"></div>
              <div class="size-3 rounded-full bg-yellow-500/80"></div>
              <div class="size-3 rounded-full bg-green-500/80"></div>
            </div>
            <div class="bg-muted text-muted-foreground ml-4 flex-1 rounded-md px-3 py-1 text-xs">
              https://moneymatter.app
            </div>
          </div>
          <!-- App screenshot. On mobile the tall phone capture is cropped to a
               viewport-height cap; DemoPortal lifts the cap when zooming in. -->
          <div data-hero-crop class="relative max-h-[65svh] overflow-hidden sm:max-h-none">
            <picture>
              <source
                media="(max-width: 639px)"
                srcset="/img/landing/dashboard-screenshot/dashboard-mobile-v2@1x.webp 1x, /img/landing/dashboard-screenshot/dashboard-mobile-v2@2x.webp 2x"
                width="1170"
                height="2532"
              />
              <source
                srcset="/img/landing/dashboard-screenshot/dashboard-desktop-v2@1x.webp 1x, /img/landing/dashboard-screenshot/dashboard-desktop-v2@2x.webp 2x"
                width="1612"
                height="935"
              />
              <img
                src="/img/landing/dashboard-screenshot/dashboard-desktop-v2@1x.webp"
                alt="MoneyMatter budget tracker dashboard showing expense overview and financial analytics"
                width="1612"
                height="935"
                class="w-full"
                loading="eager"
                fetchpriority="high"
              />
            </picture>

            <div
              data-hero-fade
              class="pointer-events-none absolute inset-x-0 bottom-0 h-48 bg-linear-to-t from-background to-transparent sm:hidden"
            >
            </div>

            <!-- Vue island: DemoPortal overlays the screenshot -->
            <slot name="demo-portal" />
          </div>
        </div>

        <!-- GitHub Activity (Vue island slot) -->
        <div class="hero-fade-in mt-8" style="animation-delay: 0.8s">
          <slot name="github-activity" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Gradient text */
  .hero-gradient-text {
    background-image: linear-gradient(90deg, #8b5cf6 0%, #a855f7 25%, #ec4899 50%, #a855f7 75%, #8b5cf6 100%) !important;
    background-size: 200% 100% !important;
    background-position: 50% 50% !important;
  }

  /* Hero content slide-up animation */
  .hero-fade-in {
    animation: hero-slide-up 0.8s ease-out both;
  }

  @keyframes hero-slide-up {
    from {
      transform: translateY(20px);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
