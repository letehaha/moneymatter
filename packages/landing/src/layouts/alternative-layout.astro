---
import BaseLayout from './base-layout.astro';
import '@/styles/alternative-page.css';
import LandingHeader from '@/components/landing-header.astro';
import CtaSection from '@/components/cta-section.astro';
import LandingFooter from '@/components/landing-footer.astro';
import LucideIcon from '@/components/lucide-icon.astro';
import Screenshot from '@/components/screenshot.astro';
import FaqAsk from '@/components/faq-ask.vue';
import FaqDetails from '@/components/faq-details.astro';
import DemoStartButton from '@/components/demo-start-button.astro';
import FaqContact from '@/components/faq-contact.astro';
import { ALTERNATIVE_PAGES } from '@/lib/alternatives';
import { GITHUB_URL, ROADMAP_URL } from '@/lib/github-api';
import { FAQ_ASK_STRINGS } from '@/i18n/client';
import { useI18n } from '@/i18n';

interface Props {
  title: string;
  description: string;
  competitor: string;
  competitorShort?: string;
  heading: string;
  intro: string;
  checkedOn: string;
  comparisonNote?: string;
  atAGlance: { value: string; label: string }[];
  highlights: { title: string; icon: string; items: { lead: string; text: string }[] }[];
  comparison: { feature: string; icon: string; competitor: string; moneymatter: string }[];
  importGuideUrl: string;
  importGuideLabel?: string;
  steps: string[];
  screenshot?: { name: string; alt: string; width: number; height: number };
  imported: string[];
  importLimits: string[];
  faq: { question: string; answer: string }[];
  betterFit: string[];
  trademarkNote: string;
  sources: { label: string; href: string; raw?: boolean }[];
  importFirst?: boolean;
  importLead?: string;
  whyCloud?: { heading: string; items: { lead: string; text: string }[] };
}

const {
  title,
  description,
  competitor,
  competitorShort: short = competitor,
  heading,
  intro,
  checkedOn,
  comparisonNote = `${short} details checked on ${checkedOn} against the <a href="#sources">sources at the end of this page</a>.`,
  atAGlance,
  highlights,
  comparison,
  importGuideUrl,
  importGuideLabel = `${short} import guide`,
  steps,
  screenshot,
  imported,
  importLimits,
  faq,
  betterFit,
  trademarkNote,
  sources,
  importFirst = false,
  importLead,
  whyCloud,
} = Astro.props;

const sectionOrder = importFirst ? ['import', 'comparison', 'highlights'] : ['comparison', 'highlights', 'import'];
const hasRoute = Astro.slots.has('default');
const bands = [...sectionOrder, hasRoute && 'route', whyCloud && 'cloud', 'faq', 'others'].filter(Boolean);
const band = ({ key }: { key: string }) => (bands.indexOf(key) % 2 === 0 ? 'sec sec-soft alt-s' : 'sec alt-s');

const path = Astro.url.pathname.replace(/\/$/, '');
const current = ALTERNATIVE_PAGES.find((page) => page.href === path);
if (!current) throw new Error(`${path} is missing from ALTERNATIVE_PAGES`);
const otherAlternatives = ALTERNATIVE_PAGES.filter((page) => page.href !== path);

const { t, url, clientProps } = useI18n(Astro);
// Amounts, counts, codes and file extensions stay as written; every other value is a translatable phrase.
const LITERAL_VALUE = /^(\$\d+|\d+\+|[A-Z0-9.-]+|\.\w+)$/;
---

<BaseLayout title={t(title)} description={t(description)}>
  <LandingHeader />
  <main id="main">
    <section class="sec alt-s alt-hero">
      <div class="wrap">
        <nav class="eyebrow alt-crumbs" aria-label={t('Breadcrumb')}>
          <ol>
            <li><a href={url({ href: '/alternatives' })}>{t('Compare')}</a></li>
            <li aria-current="page">{competitor}</li>
          </ol>
        </nav>
        <div class="alt-hero-grid">
          <div>
            <h1>{t(heading)}</h1>
            <p class="alt-hero-sub">{t(intro)}</p>
            <div class="alt-cta">
              <a class="btn btn-primary btn-lg" href="/sign-up" data-track="landing_cta_clicked" data-track-location="hero"
                >{t('Try for free')}<svg class="btn-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"
                  ></path></svg
                ></a
              >
              <DemoStartButton location="hero" />
            </div>
            <p class="hero-note" set:html={t('<strong>40-day free trial.</strong> No card needed.')} />
          </div>
          <aside class="plate alt-verdict" aria-labelledby="alt-verdict-h">
            <p class="alt-kicker" id="alt-verdict-h">{t('The short answer')}</p>
            <ul>
              <li>
                <span class="itile sm">
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#r-check" /></svg>
                </span>
                <p set:html={t(`<strong>Switch if</strong> ${current.switchIf}`)} />
              </li>
              <li>
                <span class="itile sm alt-tile-mute">
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><use href="#r-minus" /></svg>
                </span>
                <p set:html={t(`<strong>Stay on ${current.stayOn} if</strong> ${current.stayIf}`)} />
              </li>
            </ul>
            <p class="alt-verdict-foot">
              <LucideIcon name="download" class="ic" />
              {t(current.importer)}
            </p>
          </aside>
        </div>
        <dl class="plate alt-facts">
          {
            atAGlance.map((fact) => (
              <div>
                <dt>{t(fact.label)}</dt>
                <dd>{LITERAL_VALUE.test(fact.value) ? fact.value : t(fact.value)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    {
      sectionOrder.map((key) =>
        key === 'comparison' ? (
          <section class={band({ key: 'comparison' })} id="compare">
            <div class="wrap">
              <p class="eyebrow">{t('Feature by feature')}</p>
              <h2>{t(`${short} and MoneyMatter side by side`)}</h2>
              <p
                class="lede"
                set:html={`${t(comparisonNote)} ${t('MoneyMatter plans are on the <a href="{pricing}">pricing section</a>.', { pricing: url({ href: '/#pricing' }) })}`}
              />
              <div class="plate alt-table-box">
                <table class="alt-table">
                  <caption class="sr-only">
                    {t(`${competitor} and MoneyMatter compared, feature by feature`)}
                  </caption>
                  <thead>
                    <tr>
                      <td></td>
                      <th scope="col">{competitor}</th>
                      <th scope="col" class="alt-mm">
                        MoneyMatter
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {comparison.map((row) => (
                      <tr>
                        <th scope="row">
                          <span class="itile sm">
                            <LucideIcon name={row.icon} class="ic" />
                          </span>
                          {t(row.feature)}
                        </th>
                        <td>
                          <span class="alt-who">{short}</span>
                          {t(row.competitor)}
                        </td>
                        <td class="alt-mm">
                          <span class="alt-who">MoneyMatter</span>
                          {t(row.moneymatter)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        ) : key === 'highlights' ? (
          <section class={band({ key: 'highlights' })} id="what-you-get">
            <div class="wrap">
              <p class="eyebrow">{t('Why switch')}</p>
              <h2>{t('What you get with MoneyMatter')}</h2>
              <div class="alt-groups">
                {highlights.map((group, index) => (
                  <article class="alt-group">
                    <div class="plate">
                      <div class="alt-group-head">
                        <span class="itile">
                          <LucideIcon name={group.icon} class="ic" />
                        </span>
                        <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                        <h3>{t(group.title)}</h3>
                      </div>
                      <dl class="alt-dl">
                        {group.items.map((item) => (
                          <div>
                            <dt>{t(item.lead)}</dt>
                            <dd>{t(item.text)}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  </article>
                ))}
              </div>
              <p
                class="alt-more"
                set:html={t(
                  'See what is planned on the <a href="{roadmap}" target="_blank" rel="noopener noreferrer">public roadmap</a>, read the code on <a href="{github}" target="_blank" rel="noopener noreferrer">GitHub</a>, or see how <a href="{selfHost}">self-hosting</a> works.',
                  { roadmap: ROADMAP_URL, github: GITHUB_URL, selfHost: url({ href: '/#open-source' }) },
                )}
              />
            </div>
          </section>
        ) : (
          <section class={band({ key: 'import' })} id="import">
            <div class="wrap">
              <p class="eyebrow">{t('Import')}</p>
              <h2>{t(`Move your ${short} history`)}</h2>
              <p class="lede">
                {importLead && t(importLead)} <Fragment
                  set:html={t(`The <a href="{href}">${importGuideLabel}</a> covers every option.`, { href: importGuideUrl })}
                />
              </p>
              <div class="alt-import">
                <ol class="alt-steps">
                  {steps.map((step) => (
                    <li>{t(step)}</li>
                  ))}
                </ol>
                {screenshot && (
                  <figure class="win alt-shot">
                    <div class="shot-bar" aria-hidden="true">
                      <i></i>
                      <i></i>
                      <i></i>
                      <span>{t('Settings · Import/Export')}</span>
                    </div>
                    <Screenshot {...screenshot} alt={t(screenshot.alt)} />
                  </figure>
                )}
              </div>
              <div class="alt-lists">
                <div class="plate alt-list">
                  <h3>
                    <span class="alt-mark alt-yes">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#r-check" /></svg>
                    </span>
                    {t('What comes across')}
                  </h3>
                  <ul>
                    {imported.map((item) => (
                      <li>
                        <svg class="ic alt-yes" viewBox="0 0 24 24" aria-hidden="true"><use href="#r-check" /></svg>
                        {t(item)}
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="plate alt-list">
                  <h3>
                    <span class="alt-mark alt-no">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#r-minus" /></svg>
                    </span>
                    {t('Limits of the import')}
                  </h3>
                  <ul>
                    {importLimits.map((item) => (
                      <li>
                        <svg class="ic alt-no" viewBox="0 0 24 24" aria-hidden="true"><use href="#r-minus" /></svg>
                        {t(item)}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <slot name="import-note" />
            </div>
          </section>
        ),
      )
    }

    {
      hasRoute && (
        <section class={band({ key: 'route' })}>
          <div class="wrap">
            <slot />
          </div>
        </section>
      )
    }

    {
      whyCloud && (
        <section class={band({ key: 'cloud' })} id="hosting">
          <div class="wrap">
            <p class="eyebrow">{t('Hosting')}</p>
            <h2>{t(whyCloud.heading)}</h2>
            <p class="lede">
              <slot name="why-cloud-intro" />
            </p>
            <dl class="plate alt-dl alt-rows">
              {whyCloud.items.map((item) => (
                <div>
                  <dt>{t(item.lead)}</dt>
                  <dd>{t(item.text)}</dd>
                </div>
              ))}
            </dl>
          </div>
        </section>
      )
    }

    <section class={band({ key: 'faq' })} id="faq">
      <div class="wrap">
        <div class="faq2">
          <div>
            <p class="eyebrow">{t('FAQ')}</p>
            <h2>{t('Questions about switching')}</h2>
            <FaqContact />
          </div>
          <div class="faq2-main">
            <FaqDetails items={faq.map((item) => ({ question: t(item.question), answer: t(item.answer) }))} />
            <FaqAsk client:visible class="alt-ask" {...clientProps({ texts: FAQ_ASK_STRINGS })} />
          </div>
        </div>
        <div class="plate alt-fit">
          <h3>{t(`When ${short} is the better fit`)}</h3>
          <ul>
            {betterFit.map((item) => <li>{t(item)}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class={band({ key: 'others' })} id="other-comparisons">
      <div class="wrap">
        <p class="eyebrow">{t('Compare')}</p>
        <h2>{t('Other comparisons')}</h2>
        <div class="alt-others">
          {
            otherAlternatives.map((page) => (
              <a class="plate alt-other" href={url({ href: page.href })}>
                <strong>{t(page.label)}</strong>
                <span>{t(page.verdict)}</span>
                <span class="alt-imp">
                  <b>{t('Import:')}</b> {t(page.importer)}
                </span>
                <em>
                  {t('Read the comparison')}
                  <LucideIcon name="arrow-right" class="ic" />
                </em>
              </a>
            ))
          }
        </div>
        <p
          class="alt-more"
          set:html={t('<a href="{href}">All of them are on one page</a>.', { href: url({ href: '/alternatives' }) })}
        />
        <div class="alt-fine" id="sources">
          <p>{t(trademarkNote)}</p>
          <details open>
            <summary>{t(`Sources, checked on ${checkedOn}`)}<LucideIcon name="chevron-down" class="ic" /></summary>
            <ul>
              {
                sources.map((source) => (
                  <li>
                    <a href={source.href} target="_blank" rel="noopener noreferrer nofollow">
                      {source.raw ? source.label : t(source.label)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </div>
      </div>
    </section>

    <CtaSection />
  </main>
  <LandingFooter />
</BaseLayout>

