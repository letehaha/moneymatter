---
// Font CSS must be imported here rather than from global.css: the Tailwind Vite
// plugin inlines @import-ed CSS but never emits the referenced woff2 assets.
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@/styles/site/tokens.css';
import '@/styles/site/base.css';
import '@/styles/site/header.css';
import '@/styles/site/footer.css';
import '@/styles/site/faq.css';
import '@/styles/site/final.css';
import SiteSprites from '@/components/site-sprites.astro';
import { useI18n } from '@/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { t, url, locale } = useI18n(Astro);

const {
  title,
  description = t('Open-source budget tracking app. Connect your banks, track expenses, set budgets, and monitor investments. Self-host with Docker or use our cloud. Your data stays yours.'),
  ogImage = '/img/og-image.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://moneymatter.app';
const canonicalUrl = new URL(url({ href: Astro.url.pathname }), siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Runs before first paint so the page never flashes the wrong theme. Same storage key as the SPA. -->
    <script is:inline>
      (() => {
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          let pref = document.documentElement.dataset.themeChoice;
          if (!pref) {
            try {
              pref = localStorage.getItem('preferred-theme');
            } catch {}
          }
          const theme = pref === 'light' || pref === 'dark' ? pref : media.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        };
        apply();
        media.addEventListener('change', apply);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="MoneyMatter" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/img/logo.svg" />

    <!-- Runtime config shim, assigning window.__APP_CONFIG__. In production the
         container entrypoint writes it and nginx serves it from an exact-match
         `/config.js` location shared with the SPA; a public/ placeholder covers
         `astro dev`. `is:inline` keeps Astro from bundling it into a hashed
         module, which would defer it past island hydration and lose the
         per-container rewrite. -->
    <script is:inline src="/config.js"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t('Skip to content')}</a>
    <SiteSprites />
    <slot />
  </body>
</html>

<script>
  import { rememberLocale } from '@/i18n/client';
  import { analyticsLoading, initPostHog, trackAnalyticsEvent, TRACKED_CLICK_LOCATIONS } from '@/lib/posthog';
  import { initWebMcp } from '@/lib/webmcp';

  initPostHog();
  initWebMcp();

  if (document.documentElement.lang !== 'en') {
    document.addEventListener(
      'click',
      (event) => {
        const handoff = 'a[href="/sign-up"], a[href="/sign-in"], [data-demo-start], [data-demo-portal]';
        if ((event.target as Element).closest?.(handoff)) rememberLocale();
      },
      true,
    );
  }

  document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) => {
    el.addEventListener('click', (click) => {
      const { track: event, trackLocation: location } = el.dataset;
      const allowed: readonly string[] | undefined = TRACKED_CLICK_LOCATIONS[event as keyof typeof TRACKED_CLICK_LOCATIONS];
      if (!location || !allowed?.includes(location)) {
        if (import.meta.env.DEV) console.warn(`Untracked click: data-track="${event}" data-track-location="${location}"`);
        return;
      }

      trackAnalyticsEvent({
        event,
        properties: { location, ...(event === 'landing_cta_clicked' && { action: 'sign_up' }) },
      } as Parameters<typeof trackAnalyticsEvent>[0]);

      // A same-tab navigation would unload the page before the queued event is sent.
      const loading = analyticsLoading();
      const href =
        el instanceof HTMLAnchorElement && (!el.target || el.target === '_self') && !el.hasAttribute('download')
          ? el.href
          : '';
      const isModified = click.button !== 0 || click.metaKey || click.ctrlKey || click.shiftKey || click.altKey;
      if (!loading || !href || isModified || click.defaultPrevented) return;

      click.preventDefault();
      void Promise.race([loading, new Promise((resolve) => setTimeout(resolve, 300))]).then(() =>
        window.location.assign(href),
      );
    });
  });
</script>

<style is:global>
  @import '../styles/global.css';
</style>
