---
import LegalLayout from '@/layouts/legal-layout.astro';
import { GITHUB_URL } from '@/lib/github-api';

const linkClass = 'text-primary hover:underline';
---

<LegalLayout
  title="Support - MoneyMatter"
  description="Contact MoneyMatter support, read the docs, delete your account or manage your subscription."
  crossLinks={[
    { href: '/privacy-policy', label: 'Privacy Policy' },
    { href: '/terms-of-use', label: 'Terms of Service' },
  ]}
>
  <h1 class="mb-8 text-3xl font-bold tracking-tight sm:text-4xl">Support</h1>

  <div class="space-y-8">
    <section>
      <h2 class="text-xl font-semibold">Contact</h2>
      <ul class="text-muted-foreground mt-2 list-disc pl-5 space-y-2">
        <li>Email: <a href="mailto:support@moneymatter.app" class={linkClass}>support@moneymatter.app</a></li>
        <li>
          Bugs and feature requests:{' '}
          <a href={`${GITHUB_URL}/issues`} target="_blank" rel="noopener noreferrer" class={linkClass}>GitHub issues</a>
        </li>
        <li>
          Documentation:{' '}
          <a href="https://docs.moneymatter.app" target="_blank" rel="noopener noreferrer" class={linkClass}>
            docs.moneymatter.app</a
          >
        </li>
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-semibold">Delete your account</h2>
      <p class="text-muted-foreground mt-2">
        Go to Settings → Security → Danger Zone, choose Delete my account and type your email address to confirm. This
        permanently deletes your account and data. It cancels a subscription bought on the web, but not one bought
        through the App Store, so cancel that one first. If you can't sign in, email us from your account's email
        address.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold">Manage your subscription</h2>
      <ul class="text-muted-foreground mt-2 list-disc pl-5 space-y-2">
        <li>
          Bought in the iOS app: use your{' '}
          <a
            href="https://apps.apple.com/account/subscriptions"
            target="_blank"
            rel="noopener noreferrer"
            class={linkClass}
          >
            App Store subscriptions</a
          >.
        </li>
        <li>Bought on the web: go to Settings → Plan &amp; billing.</li>
      </ul>
    </section>
  </div>
</LegalLayout>
