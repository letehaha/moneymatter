---
import DemoStartButton from '@/components/demo-start-button.astro';
import BaseLayout from '@/layouts/base-layout.astro';
---

<BaseLayout
  title="Live Demo | MoneyMatter"
  description="Open a MoneyMatter demo account filled with sample data. No signup required."
  noindex
>
  <main id="main" class="flex min-h-screen flex-col items-center justify-center gap-6 px-4 text-center">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">MoneyMatter live demo</h1>
    <p class="text-muted-foreground max-w-md">
      Opens a demo account filled with sample data. If it doesn't start by itself, use the button.
    </p>
    <DemoStartButton location="demo_link" replaceHistory />
    <p class="hero-note">No signup required &bull; Sample data</p>
    <a href="/" class="text-primary-text text-sm hover:underline">Back to moneymatter.app</a>
  </main>
</BaseLayout>

<script>
  document.querySelector<HTMLButtonElement>('[data-demo-start]')?.click();
</script>
