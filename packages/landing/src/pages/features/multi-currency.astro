---
import FeatureLayout from '@/layouts/feature-layout.astro';

const SECTIONS = [
  {
    heading: 'Track accounts in more than 150 currencies, with one total',
    text: 'Keep a salary account in EUR, savings in USD and a card in PLN. Each account shows its balance in its own currency, and the dashboard, stats and reports add everything up in one base currency that you pick when you sign up.',
    bullets: ['A bank connection or an import that brings a new currency adds it to your list for you'],
    screenshot: {
      name: 'features/settings/currencies-overview',
      alt: 'The Currencies settings page with US Dollar as the base currency, and Euro and Polish Zloty showing live exchange rates in both directions and their account counts',
      width: 864,
      height: 369,
    },
  },
  {
    heading: 'Foreign-currency transactions converted at the rate of their date',
    text: "Say your base currency is EUR and you pay 50 USD on 3 March. The transaction is saved as 50 USD, with a base amount worked out from that day's rate. Back-date a transaction and it uses the rate for that past date. The converted amount is kept, so last month's report shows the same numbers today as it did last month.",
    bullets: [
      'See both amounts side by side in the Base amount column of Table view',
      'Paying abroad from a home-currency card? Note what you paid in the local currency as the Original amount, for your records',
    ],
  },
  {
    heading: 'Daily exchange rates for your balances and net worth',
    text: 'Market rates update once a day, and each update revalues your foreign-currency accounts. Hold 1,000 USD with EUR as your base currency, and your net worth goes up on a day the dollar strengthens, with no income recorded.',
  },
  {
    heading: 'Set a custom exchange rate for any currency',
    text: 'If you would rather use the rate your bank gives you, open the currency on the Currencies page, uncheck Live update and type your rate. Balances in that currency update straight away. New and edited transactions use your rate, and saved transactions keep their base amounts.',
    screenshot: {
      name: 'features/settings/custom-exchange-rate',
      alt: 'The Polish Zloty row expanded on the Currencies page with Live update unchecked and a custom rate of 1 PLN = 0.25 USD typed in, next to the Save and Set as base currency buttons',
      width: 872,
      height: 642,
    },
  },
  {
    heading: 'Record currency exchanges at the rate you really got',
    text: "Move 500 USD to a EUR card and 460 EUR arrives? Enter both amounts in one transfer. The rate is whatever your two amounts imply, so your records match what your bank or exchange charged. A transfer between your own accounts doesn't count as income or spending.",
  },
  {
    heading: 'Change your base currency after a move',
    text: "Moved from Poland to Germany? Switch your base currency to EUR and MoneyMatter recalculates every converted amount from your original amounts, using the market rate for each transaction's own date. Balance history is rebuilt in EUR too, so past reports and charts all read in your new currency.",
  },
];

const GOOD_TO_KNOW = [
  'At sign-up you can pick any currency as your base. Later changes work only for 39 currencies with long-term rate history, including USD, EUR, GBP, PLN, UAH, CHF, JPY, CAD and AUD.',
  "To change your base currency, first end any account sharing or household and delete your budget. You can't restore that budget while you are on the new base currency.",
  "A custom rate covers a whole currency on every date. You can't set a rate on a single transaction.",
  "An account's currency can't be changed after you create it.",
];

const FAQ = [
  {
    question: 'How many currencies does MoneyMatter support?',
    answer:
      'More than 150 traditional currencies, and you can use as many of them as you like at once. Crypto is tracked separately, as an investment holding.',
  },
  {
    question: 'Which exchange rate is used for my transactions?',
    answer:
      'The market rate for the date of the transaction, unless you set a custom rate for that currency. If there is no market rate for that exact day, such as a date in the future, the most recent available rate is used.',
  },
  {
    question: 'Do my old reports change when exchange rates move?',
    answer:
      'Spending and income reports do not change, because each transaction keeps its saved converted amount. Account balances are revalued daily, so a balance chart and a spending report for the same month can convert USD at different rates.',
  },
  {
    question: 'Can I change my base currency later?',
    answer:
      'Yes, more than once, as long as the new currency is one of the 39 with long-term rate history. The change runs in the background and can take a few minutes, and you cannot edit amounts until it finishes. If it fails, nothing is converted and you can try again.',
  },
  {
    question: 'Does multi-currency budgeting cost extra?',
    answer:
      'No. Multiple currencies, daily exchange rates and custom rates are part of the Essential plan, at $5 a month or $30 a year before tax, and of Plus and the 40-day free trial. Connecting banks needs Plus. Self-hosting is free.',
  },
];

const GUIDES = [
  { label: 'Base currency and currencies', href: 'https://docs.moneymatter.app/settings/base-currency-and-currencies/' },
  { label: 'How stats are calculated', href: 'https://docs.moneymatter.app/stats/how-stats-are-calculated/' },
];

const RELATED = ['/features/transfers-and-refunds', '/features/net-worth-tracker', '/features/bank-sync'];
---

<FeatureLayout
  title="Multi-Currency Budget App with Daily Rates | MoneyMatter"
  description="A multi-currency budget app for accounts in more than 150 currencies. See one total, with each transaction converted at the exchange rate of its date."
  heading="A multi-currency budget app for money in more than one country"
  intro="MoneyMatter is a multi-currency budget app for people who hold accounts in more than one currency. It keeps every amount as you entered it, converts each transaction at the exchange rate of its date, and shows your totals in one base currency."
  sections={SECTIONS}
  goodToKnow={GOOD_TO_KNOW}
  faq={FAQ}
  guides={GUIDES}
  related={RELATED}
/>
