---
import FeatureLayout from '@/layouts/feature-layout.astro';

const SECTIONS = [
  {
    heading: "Track your car's value as it depreciates",
    text: 'The price you paid stops being useful the day you drive off. Add a car, SUV, truck, EV or motorcycle with its purchase price and date, and MoneyMatter estimates its value today and keeps lowering it as the vehicle ages. The value appears in your net worth, converted to your base currency.',
    bullets: ['Choose a slow, average or fast depreciation pattern, or set your own annual rate'],
    screenshot: {
      name: 'features/accounts/add-vehicle-form',
      alt: 'The Add vehicle form filled in for a 2022 Toyota Camry, with the name, currency, make, model, year, purchase price and purchase date fields, plus vehicle class, depreciation pattern and salvage floor',
      width: 572,
      height: 870,
    },
  },
  {
    heading: 'Car depreciation estimate: the biggest drops come first',
    text: "Each year's drop comes off the value left after the previous year. A 28,000 sedan on the class default loses 20% in year one, to 22,400. It then loses 15% in year two, to 19,040, and 12% in year three, to about 16,755. The vehicle page shows the current value, the total depreciation, the value projected in 5 years and a chart of the whole curve, which helps when you are deciding whether to sell now or keep driving.",
    screenshot: {
      name: 'features/accounts/vehicle-details-page',
      alt: 'The page for a 2021 BMW X5 showing its current value, purchase price, total depreciation and value projected in 5 years, above a Value over time chart that runs down toward the salvage floor',
      width: 1150,
      height: 870,
    },
  },
  {
    heading: "Correct your car's value and record the sale",
    text: 'Got a dealer quote or a sale offer? Override the value with a number and a date, and the estimate restarts from there at the first-year rate. The override stays out of your income and spending reports, and you can undo it. When you sell, set the value to 0 on the sale date. Your past net worth keeps the car for the time you owned it, and it drops out from that day on.',
  },
  {
    heading: 'Track angel investments and SPV deals with TVPI, DPI and IRR',
    text: 'Venture deals rarely fit in a stock tracker, because they have no market price and their cash arrives years apart. Record each deal with its target company, principal, fees, carry and hurdle, then log capital calls, distributions, valuation updates, write-downs, fee payments and exits as they happen. Say you put 27,000 into an SPV, including the entry fee, later received 9,000 back, and the latest valuation is 40,000. MoneyMatter shows a TVPI of 1.81x and a DPI of 0.33x, plus an IRR based on the actual dates.',
    bullets: [
      'Save a platform with your usual fee terms, and new deals on it start with them filled in',
      'Management fees are not charged automatically, so log them as fee payments when you pay them',
      'A connected AI assistant, such as Claude or ChatGPT over MCP, can read your deals and log new events',
    ],
  },
  {
    heading: 'Carry and hurdle worked out on every distribution',
    text: 'SPV statements usually show a gross distribution, with carry taken before the money reaches you. Enter the gross amount, and MoneyMatter returns your cost basis first, then applies the carry and hurdle to the profit, the way a European waterfall does. Your returns are calculated on the net amount. The hurdle is a simple yearly estimate with no GP catch-up, so if the platform reports a different figure, enter its carry and net amounts instead.',
  },
  {
    heading: 'Link capital calls and distributions to your transactions',
    text: 'Link a capital call or a distribution to the transaction that moved the money, so your accounts and your deal record agree. One event can link to several transactions, which covers a call you paid in two installments. A linked transaction counts as a transfer to the venture, so it stays out of your income and spending and shows up in your money flow report. If the money moved somewhere you do not track, mark the event as out of wallet.',
    bullets: ['Linked transactions must be in the deal currency and add up to the exact net amount of the event'],
  },
];

const GOOD_TO_KNOW = [
  'A vehicle value is an estimate from a depreciation curve. MoneyMatter does not look up market prices, and mileage or condition do not change it.',
  'A vehicle tracks value only. Fuel, insurance and maintenance are regular expenses under the Vehicle categories, and they are not totaled per car.',
  'A deal has no live valuation. Its current value is the latest one you recorded, or what you paid in minus distributions until you record one, so TVPI and IRR are only as good as your updates. Returns are per deal, with no combined TVPI or IRR across deals.',
  'Every deal is recorded as a single-company or multi-company SPV, so a direct angel check goes in as a single-company deal. There are no fields for share counts or SAFE terms.',
];

const FAQ = [
  {
    question: 'How much does a car depreciate per year?',
    answer:
      "On MoneyMatter's default curves, a car loses 15% to 25% of its value in the first year, depending on its class, and less in later years, down to 4% or 5% a year by year ten. First-year rates are 15% for trucks, 18% for SUVs, 20% for sedans, 22% for EVs and 25% for luxury cars.",
  },
  {
    question: 'Should I include my car in my net worth?',
    answer:
      'Yes, if you count it at what it would sell for today, minus what you owe on it. MoneyMatter includes vehicles by default and subtracts tracked loans, so a car worth 20,000 with 12,000 left on its loan adds 8,000. The Net Worth and Balance trend widgets let you leave vehicles out, and the FIRE planner keeps them off until you switch them on.',
  },
  {
    question: 'How do I track angel investments and SPVs?',
    answer:
      'Create a deal in MoneyMatter with its principal and fee terms, then add events such as capital calls, distributions and valuation updates as they happen. For a deal you already hold, enter the original investment date and past events with their real dates, and the metrics work from those dates.',
  },
  {
    question: 'What is the difference between TVPI, DPI and IRR?',
    answer:
      'TVPI is total value, meaning what you got back plus what the deal is worth now, divided by what you paid in. DPI counts only the cash you got back, so it shows what is realized. IRR is the annual return that takes timing into account. MoneyMatter calculates all three from your events, with fees included in what you paid in.',
  },
  {
    question: 'Do venture deals count toward my net worth?',
    answer:
      'Yes. MoneyMatter counts them as Ventures in the Net Worth History report and the dashboard widgets, converted to your base currency, and you can leave them out of the widgets. A fully exited or written-off deal has a current value of 0.',
  },
  {
    question: 'How much does car and venture deal tracking cost?',
    answer:
      'Vehicle and venture deal tracking are in every MoneyMatter plan, from $30 a year on Essential, and in the 40-day free trial. Neither needs bank sync, so you do not need Plus for them. Self-hosting is free with every feature.',
  },
];

const GUIDES = [
  { label: 'Vehicles', href: 'https://docs.moneymatter.app/accounts/vehicles/' },
  { label: 'Analytics reports', href: 'https://docs.moneymatter.app/stats/analytics-reports/' },
  { label: 'How stats are calculated', href: 'https://docs.moneymatter.app/stats/how-stats-are-calculated/' },
];

const RELATED = ['/features/net-worth-tracker', '/features/investment-tracking', '/features/loan-tracking'];
---

<FeatureLayout
  title="Car Depreciation and Angel Investment Tracker | MoneyMatter"
  description="Car depreciation tracker and angel investment tracker. See what your car is worth today and track SPV deals with TVPI, DPI and IRR in your net worth."
  heading="Car depreciation tracker and angel investment tracker for your net worth"
  intro="MoneyMatter is a car depreciation tracker and an angel investment tracker. It estimates what your car is worth today, calculates the returns on your venture deals from the events you record, and counts both in your net worth."
  sections={SECTIONS}
  goodToKnow={GOOD_TO_KNOW}
  faq={FAQ}
  guides={GUIDES}
  related={RELATED}
/>
