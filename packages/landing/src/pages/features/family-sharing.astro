---
import FeatureLayout from '@/layouts/feature-layout.astro';

const SECTIONS = [
  {
    heading: 'Share your whole household, one account or one spending tracker',
    text: 'Each person keeps their own login, and you decide how much of your money they see. You can mix these for the same person: give your partner read access to your household, then share the joint account with write access so they can add to it. The specific share decides what they can do on that account.',
    bullets: [
      'Household: every account you own, including ones you add later',
      'One account: a joint card for your partner, or a business account for your accountant',
      'One tracker: a trip or renovation limit that several people spend against. Trackers are always shared one at a time, even inside a household',
    ],
  },
  {
    heading: 'Invite by email and set read or write access for each person',
    text: 'Enter their email address and pick an access level, which you can change later. They accept from the email or from Shared with me in Settings, and someone without an account can sign up with the invited address first. Invitations expire after 7 days. People who add transactions to your account use your categories and payees, so your reports stay consistent.',
    bullets: [
      'Read: they can look and change nothing',
      'Write on an account or household: they add, edit and delete transactions, either all of them or only the ones they created',
      'Write on a tracker: they attach and detach their own transactions',
      "Manage on one account or tracker: they can also change or remove other people's access, and edit the tracker's settings",
      'Nobody you share with can rename or delete your accounts',
    ],
  },
  {
    heading: 'Shared accounts appear in your own cash flow and spending reports',
    text: 'When someone shares an account with you, the whole account appears in your own cash flow, expense totals and pivot reports, including their transactions. Share households both ways, and one login shows what you both spent this month. Bank connection details stay hidden. Bank sync needs Plus only for the person who connects the bank, so your partner can follow your synced transactions on Essential. A bank-connected account takes no transactions added by hand, even with write access.',
  },
  {
    heading: 'What family sharing costs: seats by plan',
    text: "A seat is one person who has accepted your invitation, not counting you. Seats come from the owner's plan, cannot be bought one by one, and the limit applies separately to your household and to each account or tracker you share. On Cloud, each person pays for their own editing rights, so two people who both add transactions need two plans.",
    bullets: [
      'Essential ($5 a month or $30 a year): 2 seats',
      'Plus ($8 a month or $55 a year): 5 seats',
      '40-day free trial: 5 seats',
      'Self-hosted: 10 seats, free. Without email set up, you send the invitation link yourself',
    ],
  },
  {
    heading: 'Record transfers between household members',
    text: 'Paying your partner back for rent? With write access to their household, you can record a transfer from your account to theirs, and both balances update. Both accounts must be ones you manage by hand, and the transfer has to start from your own account.',
  },
];

const GOOD_TO_KNOW = [
  'You and the person you share with must use the same base currency. They cannot accept until theirs matches yours, and neither of you can change it while you share.',
  'Savings goals and investment portfolios cannot be shared.',
  "A shared account does not count toward the recipient's net worth, balance trend chart or FIRE plan, so a couple does not get one combined net worth figure.",
];

const FAQ = [
  {
    question: 'Can my partner and I track money together in one app?',
    answer:
      "Yes. Each of you keeps your own login. Invite your partner to your household, and after they accept, MoneyMatter offers to share their household back with you, so you both see all of each other's accounts.",
  },
  {
    question: 'Can my partner and I share a budget?',
    answer:
      'No. A budget plan belongs to one person, and an account shared with you cannot go into your own budget plan or savings goal. For a joint limit, share a spending tracker for a trip or a renovation: you each attach your own transactions and see one total against the limit.',
  },
  {
    question: 'Does each family member need a paid plan?',
    answer:
      'Only someone who makes changes needs a plan, and each person signs up with their own account. New Cloud accounts get a 40-day free trial. After that, an account without a plan is read-only: it can still view what was already shared with it, but it cannot accept a new invitation or make changes. Self-hosted installs have no plans.',
  },
  {
    question: 'Can I give my accountant read-only access to one account?',
    answer:
      "Yes. Open the account, choose Share account, enter your accountant's email and pick read. They see that account and its transactions, and none of your other accounts.",
  },
  {
    question: 'Can we share if our accounts are in different currencies?',
    answer:
      'Yes. Accounts can be in any currency. Only the base currency has to match, so a USD account can be shared between two people whose base currency is EUR.',
  },
  {
    question: 'What happens when I stop sharing?',
    answer:
      'Their access ends, and the transactions on your account stay there, including any they added. Remove the person from the sharing panel or the Household settings page, or they can leave themselves. When someone leaves a shared tracker, the transactions they attached come off it, so its total drops. When a household share ends, transfers between you stay in both histories with balances unchanged, as separate records.',
  },
];

const GUIDES = [
  { label: 'Household seats and plans', href: 'https://docs.moneymatter.app/settings/plans-and-billing/' },
  { label: 'Manage accounts', href: 'https://docs.moneymatter.app/accounts/manage-accounts/' },
  { label: 'Base currency and currencies', href: 'https://docs.moneymatter.app/settings/base-currency-and-currencies/' },
];

const RELATED = ['/features/spending-trackers', '/features/net-worth-tracker', '/features/multi-currency'];
---

<FeatureLayout
  title="Family Finance App for Couples and Households | MoneyMatter"
  description="A family finance app for couples and households. Share one account, a spending tracker or all your accounts, with read or write access for each person."
  heading="A family finance app where you choose what each person sees"
  intro="MoneyMatter is a family finance app that lets couples and households track money together. Share all your accounts with a partner, or a single account with a parent or an accountant. You set read or write access for each person, and you can remove it whenever you want."
  sections={SECTIONS}
  goodToKnow={GOOD_TO_KNOW}
  faq={FAQ}
  guides={GUIDES}
  related={RELATED}
/>
