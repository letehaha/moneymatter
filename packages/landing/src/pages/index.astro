---
import BaseLayout from '@/layouts/base-layout.astro';
import LandingHeader from '@/components/landing-header.astro';
import HeroSection from '@/components/home/hero-section.astro';
import DemoSection from '@/components/home/demo-section.astro';
import FlowSection from '@/components/home/flow-section.astro';
import AutomationSection from '@/components/home/automation-section.astro';
import CoverageSection from '@/components/home/coverage-section.astro';
import FeaturesSection from '@/components/home/features-section.astro';
import PlanSection from '@/components/home/plan-section.astro';
import AiSection from '@/components/home/ai-section.astro';
import ReviewsSection from '@/components/home/reviews-section.astro';
import PricingSection from '@/components/home/pricing-section.astro';
import OpenSourceSection from '@/components/home/open-source-section.astro';
import FaqSection from '@/components/home/faq-section.astro';
import CtaSection from '@/components/cta-section.astro';
import LandingFooter from '@/components/landing-footer.astro';

import { FAQ_ITEMS } from '@/lib/faq';
---

<BaseLayout
  title="Open-Source Budget Tracker & Personal Finance App | MoneyMatter"
  description="Open-source budget tracking app. Connect your banks, track expenses, set budgets, and monitor investments. Self-host with Docker or use our cloud. Your data stays yours."
  canonicalUrl="https://moneymatter.app/"
>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://moneymatter.app/#website",
        "url": "https://moneymatter.app/",
        "name": "MoneyMatter",
        "description": "Open-source budget tracking app for personal finance management.",
        "inLanguage": "en"
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://moneymatter.app/#app",
        "name": "MoneyMatter",
        "description": "Open-source budget tracking app. Connect your banks, track expenses, set budgets, and monitor investments. Self-host with Docker or use our cloud. Your data stays yours.",
        "url": "https://moneymatter.app/",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "browserRequirements": "Requires JavaScript. Works best in modern browsers.",
        "offers": [
          { "@type": "Offer", "name": "Essential", "price": "30", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Plus", "price": "55", "priceCurrency": "USD" }
        ],
        "featureList": [
          "Bank account synchronization",
          "AI-powered transaction categorization",
          "AI integration via MCP (Claude, ChatGPT, OpenClaw)",
          "Budget tracking and management",
          "Multi-currency support",
          "Investment portfolio tracking",
          "FIRE planner",
          "CSV and bank statement import",
          "Self-hosting option",
          "Data export"
        ],
        "screenshot": "https://moneymatter.app/img/og-image.jpg",
        "author": {
          "@type": "Person",
          "name": "letehaha",
          "url": "https://github.com/letehaha"
        },
        "license": "https://www.gnu.org/licenses/agpl-3.0.html"
      },
      {
        "@type": "FAQPage",
        "@id": "https://moneymatter.app/#faq",
        "mainEntity": FAQ_ITEMS.map((item) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <LandingHeader />
  <main id="main">
    <HeroSection />
    <DemoSection />
    <FlowSection />
    <AutomationSection />
    <CoverageSection />
    <FeaturesSection />
    <PlanSection />
    <AiSection />
    <ReviewsSection />
    <PricingSection />
    <OpenSourceSection />
    <FaqSection />
    <CtaSection illustration />
  </main>
  <LandingFooter />
</BaseLayout>
