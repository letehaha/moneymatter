---
import BaseLayout from '@/layouts/base-layout.astro';
import BackgroundOrbs from '@/components/background-orbs.astro';
import LandingHeader from '@/components/landing-header.astro';
import HeroSection from '@/components/hero-section.astro';
import HowItWorksSection from '@/components/how-it-works-section.astro';
import ComparisonSection from '@/components/comparison-section.astro';
import FeaturesSection from '@/components/features-section.astro';
import McpSection from '@/components/mcp-section.astro';
import SelfHostSection from '@/components/self-host-section.astro';
import PricingSection from '@/components/pricing-section.astro';
import FaqSection from '@/components/faq-section.astro';
import CommunitySection from '@/components/community-section.astro';
import CtaSection from '@/components/cta-section.astro';
import LandingFooter from '@/components/landing-footer.astro';

import TryDemoButton from '@/components/try-demo-button.vue';
import GitHubActivity from '@/components/github-activity.vue';
import DemoPortal from '@/components/demo-portal.vue';
import { FAQ_ITEMS } from '@/lib/faq';
import { getGitHubStarsLabel } from '@/lib/github-stars';

const starsLabel = await getGitHubStarsLabel();
---

<BaseLayout
  title="Open-Source Budget Tracker & Personal Finance App | MoneyMatter"
  description="Open-source budget tracking app. Connect your banks, track expenses, set budgets, and monitor investments. Self-host with Docker or use our cloud. Your data stays yours."
  canonicalUrl="https://moneymatter.app/"
>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://moneymatter.app/#website",
        "url": "https://moneymatter.app/",
        "name": "MoneyMatter",
        "description": "Open-source budget tracking app for personal finance management.",
        "inLanguage": "en"
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://moneymatter.app/#app",
        "name": "MoneyMatter",
        "description": "Open-source budget tracking app. Connect your banks, track expenses, set budgets, and monitor investments. Self-host with Docker or use our cloud. Your data stays yours.",
        "url": "https://moneymatter.app/",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "browserRequirements": "Requires JavaScript. Works best in modern browsers.",
        "offers": [
          { "@type": "Offer", "name": "Essential", "price": "30", "priceCurrency": "USD" },
          { "@type": "Offer", "name": "Plus", "price": "55", "priceCurrency": "USD" }
        ],
        "featureList": [
          "Bank account synchronization",
          "AI-powered transaction categorization",
          "AI integration via MCP (Claude, ChatGPT, OpenClaw)",
          "Budget tracking and management",
          "Multi-currency support",
          "Investment portfolio tracking",
          "FIRE planner",
          "CSV and bank statement import",
          "Self-hosting option",
          "Data export"
        ],
        "screenshot": "https://moneymatter.app/img/og-image.jpg",
        "author": {
          "@type": "Person",
          "name": "letehaha",
          "url": "https://github.com/letehaha"
        },
        "license": "https://www.gnu.org/licenses/agpl-3.0.html"
      },
      {
        "@type": "FAQPage",
        "@id": "https://moneymatter.app/#faq",
        "mainEntity": FAQ_ITEMS.map((item) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": { "@type": "Answer", "text": item.answer }
        }))
      }
    ]
  })} />

  <div class="bg-background text-foreground landing-page min-h-screen">
    <BackgroundOrbs />
    <LandingHeader />

    <HeroSection>
      <TryDemoButton slot="try-demo" client:load />
      <GitHubActivity slot="github-activity" starsLabel={starsLabel} client:visible />
      <DemoPortal slot="demo-portal" client:visible />
    </HeroSection>

    <HowItWorksSection />
    <ComparisonSection />
    <FeaturesSection />
    <McpSection />
    <SelfHostSection />
    <PricingSection />
    <FaqSection />
    <CommunitySection />
    <CtaSection />
    <LandingFooter />
  </div>
</BaseLayout>

<script>
  import { trackAnalyticsEvent } from '@/lib/posthog';

  // Attach click tracking to all [data-track] elements
  document.querySelectorAll('[data-track]').forEach((el) => {
    el.addEventListener('click', () => {
      const event = el.getAttribute('data-track');
      const location = el.getAttribute('data-track-location');

      if (event === 'landing_cta_clicked' && location) {
        trackAnalyticsEvent({
          event: 'landing_cta_clicked',
          properties: { location: location as 'header' | 'hero' | 'cta_section' | 'self_host' | 'pricing', action: 'sign_up' },
        });
      } else if (event === 'landing_roadmap_clicked' && location) {
        trackAnalyticsEvent({
          event: 'landing_roadmap_clicked',
          properties: { location: location as 'hero' | 'pricing' | 'community' },
        });
      } else if (event === 'landing_github_clicked' && location) {
        trackAnalyticsEvent({
          event: 'landing_github_clicked',
          properties: { location: location as 'header_nav' | 'header_star' | 'hero' | 'self_host' | 'cta_section' | 'footer' | 'community' },
        });
      }
    });
  });
</script>

<style>
  .landing-page {
    font-family: 'Montserrat', system-ui, sans-serif;
    overflow-y: auto;
  }
</style>
