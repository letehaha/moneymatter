---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/base-layout.astro';
import LandingHeader from '@/components/landing-header.astro';
import CtaSection from '@/components/cta-section.astro';
import LandingFooter from '@/components/landing-footer.astro';
import '@/styles/feature-page.css';
import '@/styles/prose-page.css';

const guides = (await getCollection('guides')).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<BaseLayout
  title="Personal Finance Guides | MoneyMatter"
  description="Guides to setting up MoneyMatter for a specific situation, such as money in several currencies, with the steps, the mistakes to avoid and links to the docs."
>
  <LandingHeader />
  <main id="main">
    <div class="wrap">
      <div class="prose-page">
        <h1 class="text-center">Guides</h1>
        <p class="lede mx-auto text-center">
          How to set up MoneyMatter for a specific situation: what to do, in what order, and which mistakes to avoid.
          Each guide links to the full docs.
        </p>

        <ul class="mt-14 space-y-4">
          {
            guides.map((guide) => (
              <li>
                <a href={`/guides/${guide.id}`} class="plate fp-card">
                  <h2 class="text-lg">{guide.data.title}</h2>
                  <p class="text-muted-foreground text-sm leading-relaxed">{guide.data.description}</p>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <CtaSection />
  </main>
  <LandingFooter />
</BaseLayout>
