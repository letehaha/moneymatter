---

<AlternativeLayout
  title="Open Source Wallet by BudgetBakers Alternative | MoneyMatter"
  description="MoneyMatter is an open-source, self-hostable alternative to Wallet by BudgetBakers. Import your Wallet records, labels and transfers from a CSV export."
  competitor="Wallet by BudgetBakers"
  competitorShort="Wallet"
  heading="An open-source alternative to Wallet by BudgetBakers"
  intro="MoneyMatter is an open-source personal finance tracker. Try the cloud free for 40 days with no card, or host it yourself for free. Its Wallet importer brings your records, labels and transfers with you."
  checkedOn={checkedOn}
  importLead="The import takes a few minutes."
  atAGlance={AT_A_GLANCE}
  highlights={HIGHLIGHTS}
  comparison={COMPARISON}
  importGuideUrl={DOCS_IMPORT_URL}
  steps={STEPS}
  screenshot={{
    name: 'import-sources',
    width: 1344,
    height: 1082,
    alt: 'MoneyMatter import options, including the Wallet (BudgetBakers) importer',
  }}
  imported={IMPORTED}
  importLimits={IMPORT_LIMITS}
  faq={FAQ}
  betterFit={STAY_ON_WALLET}
  trademarkNote="Wallet and BudgetBakers are trademarks of BudgetBakers; MoneyMatter is not affiliated with them."
  sources={SOURCES}
>
  <p slot="import-note" class="text-muted-foreground mt-8 max-w-2xl text-sm">
    Two records are joined into one transfer when they share a date and time, sit in different accounts, and their
    amounts are within 1% of each other. See <a href={DOCS_TRANSFERS_URL} class="text-primary-text hover:underline"
      >how transfers work</a
    >.
  </p>
</AlternativeLayout>
