const COMPARISON = [
  {
    feature: 'Source code and hosting',
    competitor: 'Not published. Cloud only',
    moneymatter: 'Open source. Use the cloud or self-host for free',
  },
  {
    feature: 'Price',
    competitor: 'Not listed on the website. Shown in the app, and it differs by country and app store',
    moneymatter: '$30 a year for Essential, $55 a year for Plus, after a 40-day trial without a card',
  },
  {
    feature: 'Getting your data out',
    competitor: 'CSV and XLS export of transactions, on Premium',
    moneymatter: 'Export on every plan, plus a full account backup you can restore',
  },
  {
    feature: 'Refunds',
    competitor: 'Recorded as separate income',
    moneymatter: 'Linked to the original purchase',
  },
  {
    feature: 'AI',
    competitor: 'Automatic categorization, receipt scanning, and an MCP server for your own assistant',
    moneymatter: 'Categorization, statement parsing, an MCP server, and your own model inside the app',
  },
  {
    feature: 'Beyond bank accounts',
    competitor: 'Stocks, ETFs and crypto. Simple debts you lent or borrowed',
    moneymatter: 'Stocks, ETFs and crypto. Loans with payoff projections, vehicles and venture deals',
  },
  {
    feature: 'Bank sync',
    competitor: 'Premium. Wallet says it connects to over 15,000 institutions',
    moneymatter:
      'Plus plan, through LunchFlow, SimpleFIN, Monobank and Walutomat. LunchFlow and SimpleFIN need their own account',
  },
  {
    feature: 'Apps',
    competitor: 'iOS, Android and web, with offline mode on mobile',
