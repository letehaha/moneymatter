      },
      { lead: 'Net worth', text: 'Cash, investments, vehicles, venture deals and loans on one chart.' },
    ],
  },
  {
    title: 'Multi-currency',
    items: [
      { lead: 'About 158 currencies', text: 'Exchange rates are fetched automatically.' },
      { lead: 'Historic rates', text: 'Each transaction is converted at the rate of its own date.' },
    ],
  },
  {
    title: 'Reports to set up again',
    items: [
      {
        lead: 'Not imported',
        text: 'Reports and budgets saved in your Money file are not read, so you set them up again here.',
      },
      {
        lead: 'By category or payee',
        text: 'Pivot tables total your imported history by category, payee or tag, per week, month, quarter or year.',
      },
      {
        lead: 'Income and spending',
        text: 'A cash flow report by month, and a diagram of where each income source went.',
      },
    ],
  },
];

