const STEPS = [
  'In MoneyMatter, open Settings, then Import/Export. Under From other apps, pick Microsoft Money.',
  'Select your .mny file. If you protected it with a password in Microsoft Money, enter it. Click Continue.',
  'On Map data, choose what happens to each account: create a new one, link it to an account you already have in the same currency, or skip it. Then map the categories.',
  'On Review, check what was left out and any possible duplicates. If the file has voided transactions, tick the box to import them too.',
  'Click Import. The import runs in the background and ends with a summary of what was created, skipped or failed.',
];

const IMPORTED = [
  'Banking, credit card, cash, asset and liability accounts.',
  'Transactions with their category, payee and memo. A transaction with no memo keeps its cheque number as the note.',
  'Categories, including the two levels Money uses, mapped to yours or created during the import.',
  'Split transactions. Each line of a split becomes its own transaction, and the parent row is dropped so nothing is counted twice.',
  'Transfers between two imported accounts, once each. Money links both sides in the file, so no guessing by date or amount is involved.',
  'Voided transactions, if you tick the box: at an amount of zero, tagged "Void", with the original amount kept in the note.',
  'Password-protected files, and files up to 50 MB with up to 100,000 transactions.',
];

const IMPORT_LIMITS = [
  'Investment and loan accounts are skipped, with a warning. Set them up by hand as portfolios and loans.',
  'A transfer to an account that is not imported comes in as money moved outside the accounts you track.',
  'An account with no currency in the file is treated as USD, with a warning. The importer cannot change this, so skip the account if it is not in USD.',
  'Budgets, bills and reports are not read from the file. The importer brings accounts, transactions, transfers, categories and payees.',
  'Transactions beyond 100,000 are dropped, and rows with an unreadable date or amount are skipped. Both are reported.',
  'The duplicate check runs only for accounts you link to existing ones. Transfers are never checked.',
  'If you skip an account, its transfers are dropped too, so the account on the other side may not match its Microsoft Money balance.',
  'The upload expires after 30 minutes without activity, or 4 hours in total. Then you upload the file again.',
];

const WHY_CLOUD = [
  {
    lead: 'Hosting',
    text: 'Self-hosting needs a server with Docker Compose and at least 2 GB of RAM. On the cloud, hosting, updates and security patches are done for you.',
  },
  {
    lead: 'Backups',
    text: 'A self-hosted install is backed up with pg_dump plus the attachments volume, and that is your job.',
  },
  {
    lead: 'Price feeds',
    text: 'Stock and crypto prices, exchange rates and merchant logos are included. Self-hosted crypto prices and merchant logos need your own keys.',
  },
  {
    lead: 'Trial',
    text: '40 days with every cloud feature, no card needed. Paid plans start from $30/year.',
  },
];

const STAY_ON_MONEY = [
  'You want a Windows desktop program that works with no internet connection. MoneyMatter is a web app and has no offline mode.',
  'You do not want an online account or a server to look after. MoneyMatter is either a cloud account or a Docker install you run.',
  'Most of your history is in investment or loan accounts. The import skips them, so you would re-enter that part by hand.',
  'You hold bonds, mutual funds or employee stock options, or you rely on cost-basis lots, capital-gains reports or tax reports. MoneyMatter tracks stocks, ETFs and crypto, shows the cost basis of a holding as its average cost with no view of lots, and has no capital-gains or tax reports.',
  'You use the loan amortization schedule or the Lifetime Planner. MoneyMatter projects a loan balance on a chart but has no amortization table and no principal and interest split per payment, and its only long-term planner is the FIRE planner on the Plus plan.',
  'Money Plus Sunset still does everything you need, and typing in or importing statements yourself is fine by you.',
  'You want another Windows desktop program that reads your Money data. Quicken says Quicken for Windows imports data from Microsoft Money 2008 and 2009, Deluxe and higher.',
  'You want to pay once instead of every year. Moneyspire sells its licence as a one-time purchase and calls it perpetual. Its bank sync, cloud sync and quote downloads are included for one year.',
];

const FAQ = [
  {
    question: 'Do I have to export anything from Microsoft Money first?',
    answer:
      'No. You upload the .mny file itself and MoneyMatter reads it. There is no QIF or CSV export step, and Microsoft Money does not need to be installed on the computer you upload from.',
  },
  {
    question: 'Can MoneyMatter open a password-protected .mny file?',
    answer:
      'Yes. Enter the file password next to the file when you upload it. For a file written by Money 2002 or later, a missing or wrong password stops the import and asks for it, and nothing is imported until the file opens. Files written before Money 2002 open without the password.',
  },
  {
    question: 'Which Microsoft Money versions does it work with?',
    answer:
      'The importer is tested with sample files from Money 2001, 2002, 2004, 2005, 2008 and Money Plus Sunset. Files written by Money 2001 and 2002 come across without payees. If your file is laid out differently, the review step names what could not be read.',
  },
  {
    question: 'Are my investment and loan accounts imported?',
    answer:
      'No. They are skipped with a warning, and transfers to them arrive as money moved outside the accounts you track. MoneyMatter has portfolios and loans, but you set those up yourself.',
  },
  {
    question: 'Is my .mny file kept after the import?',
    answer:
      'No. MoneyMatter does not keep the uploaded file, only what it read from it, and that expires after 30 minutes without activity or 4 hours in total. The file on your computer is not changed, and an import can be undone from Import History.',
  },
];

const SOURCES = [
  {
    label: "Microsoft: Microsoft Money Plus 'Sunset' Versions (archived 25 June 2011)",
    href: 'https://web.archive.org/web/20110625114622/http://www.microsoft.com/money/sunset.mspx',
  },
  {
    label: 'Microsoft Support KB 2118008: What Is Microsoft Money Plus Sunset? (archived 24 December 2011)',
    href: 'https://web.archive.org/web/20111224112703/http://support.microsoft.com/kb/2118008',
