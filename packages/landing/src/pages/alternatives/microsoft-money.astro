  {
    label: 'Microsoft Q&A: How can I download MS Money now? (community answer)',
    href: 'https://learn.microsoft.com/en-us/answers/questions/3941592/how-can-i-download-ms-money-now',
  },
  {
    label: 'Microsoft Q&A: Is Microsoft Money still available in 2024? (community answer)',
    href: 'https://learn.microsoft.com/en-us/answers/questions/4064319/is-microsoft-money-still-available-in-2024',
